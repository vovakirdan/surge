pragma module, no_std;

pub tag FmtStr(string);
pub tag FmtInt(int);
pub tag FmtUInt(uint);
pub tag FmtFloat(float);
pub tag FmtBool(bool);

pub type FmtArg = FmtStr(string) | FmtInt(int) | FmtUInt(uint) | FmtFloat(float) | FmtBool(bool);

// FmtArg OWNS its string (borrow-in-union is unsound here: the argument can
// outlive the borrow, and the borrow checker does not track borrows stored in
// a union — so drop-emission would double-free the borrowed handle). We clone
// the argument into the tag once; formatting then appends it straight into the
// output (see append_fmt_arg), keeping the copy count at parity with a borrow.
pub fn fmt_arg(s: &string) -> FmtArg {
    return FmtStr(s.__clone());
}

@overload
pub fn fmt_arg(x: int) -> FmtArg {
    return FmtInt(x);
}

@overload
pub fn fmt_arg(x: uint) -> FmtArg {
    return FmtUInt(x);
}

@overload
pub fn fmt_arg(x: float) -> FmtArg {
    return FmtFloat(x);
}

@overload
pub fn fmt_arg(x: bool) -> FmtArg {
    return FmtBool(x);
}

pub fn fmt_arg_int(x: int) -> FmtArg {
    return FmtInt(x);
}

pub fn fmt_arg_uint(x: uint) -> FmtArg {
    return FmtUInt(x);
}

pub fn fmt_arg_float(x: float) -> FmtArg {
    return FmtFloat(x);
}

pub fn fmt_arg_bool(x: bool) -> FmtArg {
    return FmtBool(x);
}

// Append the argument's rendering directly onto `out`. For a string argument
// this concatenates the owned string in place (no intermediate clone), so a
// string arg costs one clone (into the tag) plus the unavoidable concat — the
// same copy count the borrowed representation had.
fn append_fmt_arg(out: string, arg: &FmtArg) -> string {
    return compare *arg {
        FmtStr(s) => out + s;
        FmtInt(x) => out + (x to string);
        FmtUInt(x) => out + (x to string);
        FmtFloat(x) => out + (x to string);
        FmtBool(x) => out + (x to string);
    };
}

pub fn format(fmt: string, ...args: FmtArg) -> string {
    let fmt_len: int = string_len_int(&fmt);
    let arg_count: int = args.__len() to int;
    let mut arg_index: int = 0;
    let mut out: string = "";
    let mut i: int = 0;
    let mut seg_start: int = 0;

    while i < fmt_len {
        let ch: uint32 = fmt[i];
        if ch == (123):uint32 {
            if i + 1 >= fmt_len {
                panic("format: unmatched '{' in format string");
            }
            let next: uint32 = fmt[i + 1];
            if next == (123):uint32 {
                if i > seg_start {
                    out = out + fmt[[seg_start..i]];
                }
                out = out + "{";
                i = i + 2;
                seg_start = i;
                continue;
            }
            if next == (125):uint32 {
                if i > seg_start {
                    out = out + fmt[[seg_start..i]];
                }
                if arg_index >= arg_count {
                    panic("format: not enough arguments for format string");
                }
                out = append_fmt_arg(out, args[arg_index]);
                arg_index = arg_index + 1;
                i = i + 2;
                seg_start = i;
                continue;
            }
            panic("format: unmatched '{' in format string");
        }
        if ch == (125):uint32 {
            if i + 1 < fmt_len && fmt[i + 1] == (125):uint32 {
                if i > seg_start {
                    out = out + fmt[[seg_start..i]];
                }
                out = out + "}";
                i = i + 2;
                seg_start = i;
                continue;
            }
            panic("format: unmatched '}' in format string");
        }
        i = i + 1;
    }

    if seg_start < fmt_len {
        out = out + fmt[[seg_start..fmt_len]];
    }
    if arg_index != arg_count {
        panic("format: too many arguments for format string");
    }
    return out;
}
