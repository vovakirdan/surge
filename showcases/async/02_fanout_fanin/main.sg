async fn job(x: int) -> int {
    sleep((x * 5):uint).await();
    return x * x;
}

@entrypoint
fn main() {
    let mut tasks: Task<int>[] = Array::<Task<int>>::with_len(8:uint);

    for i in 0..8 {
        tasks[i] = spawn job(i);
    }

    let mut sum: int = 0;
    while tasks.__len() > 0:uint {
        let raw_task = tasks.pop().safe();
        compare raw_task.await() {
            Success(v) => sum = sum + v;
            Cancelled() => nothing;
        };
    }

    print(f"sum={sum}");
}
