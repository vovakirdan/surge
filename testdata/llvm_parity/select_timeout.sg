@entrypoint
fn main() -> int {
    let r = (async {
        let worker = spawn async {
            sleep(50).await();
            ret 9;
        };
        let worker2 = worker.clone();
        let v = select {
            timeout(worker, 5) => 1;
        };
        let status = compare worker2.await() {
            Success(_) => 0;
            Cancelled() => 2;
        };
        ret v + status;
    }).await();

    compare r {
        Success(v) => print("sum=" + (v to string));
        Cancelled() => print("cancelled");
    };
    return 0;
}
