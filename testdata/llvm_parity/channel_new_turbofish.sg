// The canonical channel constructor `Channel::<T>::new` must reach the native
// lane, not just the VM: before the native emitter learned it, building this
// program failed with `unknown external function "new::<int>"`.
async fn recv_once(ch: own Channel<int>) -> int {
    let v = ch.recv();
    let out = compare v {
        Some(x) => x;
        nothing => 0;
    };
    return out;
}

@entrypoint
fn main() -> int {
    let r = (async {
        let buffered = Channel::<int>::new(2:uint);
        buffered.send(7);
        let first = compare buffered.recv() {
            Some(x) => x;
            nothing => 0;
        };

        let mut sent = 0;
        if buffered.try_send(35) {
            sent = 1;
        }
        let second = compare buffered.try_recv() {
            Some(x) => x;
            nothing => 0;
        };

        let rendezvous = Channel::<int>::new(0:uint);
        let recv_ch = rendezvous;
        let send_ch = rendezvous;
        let waiter = spawn recv_once(recv_ch);
        let _ = checkpoint().await();
        send_ch.send(58);
        let third = compare waiter.await() {
            Success(x) => x;
            Cancelled() => 0;
        };

        buffered.close();
        let after_close = compare buffered.recv() {
            Some(x) => x;
            nothing => 0;
        };

        return first + sent + second + third + after_close;
    }).await();

    compare r {
        Success(v) => print("sum=" + (v to string));
        Cancelled() => print("cancelled");
    };
    return 0;
}
