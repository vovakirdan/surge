pub fn payload64(value: uint64) -> Payload64 {
    return Payload64 {
        a = value,
        b = 2:uint64,
        c = 3:uint64,
        d = 4:uint64,
        e = 5:uint64,
        f = 6:uint64,
        g = 7:uint64,
        h = 8:uint64,
    };
}

pub fn sum64(value: &Payload64) -> uint64 {
    return value.a + value.b + value.c + value.d
        + value.e + value.f + value.g + value.h;
}

pub fn payload16(value: uint64) -> Payload16 {
    return Payload16 { a = value, b = 2:uint64 };
}

pub fn sum16(value: &Payload16) -> uint64 {
    return value.a + value.b;
}

pub fn payload4096(value: uint64) -> Payload4096 {
    let mut result: Payload4096 = default::<Payload4096>();
    result.p000.a = value;
    result.p063.h = 7:uint64;
    return result;
}

pub fn sum4096(value: &Payload4096) -> uint64 {
    return value.p000.a + value.p063.h;
}

pub fn payload8192(value: uint64) -> Payload8192 {
    let mut result: Payload8192 = default::<Payload8192>();
    result.p000.a = value;
    result.p127.h = 7:uint64;
    return result;
}

pub fn sum8192(value: &Payload8192) -> uint64 {
    return value.p000.a + value.p127.h;
}

pub fn now() -> int64 {
    return rt_monotonic_now();
}

pub fn store_latency(
    samples: &mut ArrayFixed<int64, 64>,
    index: int,
    started: int64,
) -> nothing {
    let ended: int64 = rt_monotonic_now();
    let mut elapsed: int64 = ended - started;
    if elapsed <= 0:int64 {
        elapsed = 1:int64;
    }
    samples[index] = elapsed;
}

fn render_latencies(samples: &ArrayFixed<int64, 64>) -> string {
    let mut result: string = "[";
    let mut index: int = 0;
    while index < 64 {
        if index != 0 {
            result = result + ",";
        }
        result = result + (samples[index] to string);
        index = index + 1;
    }
    return result + "]";
}

pub fn allocation_observer() -> uint64 {
    let stats: HeapStats = rt_heap_stats();
    let value: uint64 = stats.alloc_count to uint64;
    @drop stats;
    return value;
}

pub fn emit_result(
    probe: &string,
    elapsed_ns: int64,
    samples: &ArrayFixed<int64, 64>,
    checksum: uint64,
    allocations: uint64,
) -> nothing {
    let output: string = "SURGE_CARRIER_BENCH {\"schema_version\":1"
        + ",\"probe\":\"" + probe.__clone() + "\""
        + ",\"operations\":64"
        + ",\"elapsed_ns\":" + (elapsed_ns to string)
        + ",\"operation_latencies_ns\":" + render_latencies(samples)
        + ",\"checksum\":\"" + (checksum to string) + "\""
        + ",\"metrics\":{\"allocation_count\":" + (allocations to string)
        + "}}";
    print(output);
}
