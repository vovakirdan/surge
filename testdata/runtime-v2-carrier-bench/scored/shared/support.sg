@intrinsic fn rt_monotonic_now() -> int64;

@copy
@shard_movable
pub type Payload64 = {
    a: uint64,
    b: uint64,
    c: uint64,
    d: uint64,
    e: uint64,
    f: uint64,
    g: uint64,
    h: uint64,
};

@copy
@shard_movable
pub type Payload16 = { a: uint64, b: uint64 };

