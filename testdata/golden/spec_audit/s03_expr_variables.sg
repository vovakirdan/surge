// §3.1 Variables Audit

const CONSTANT: int = 42;

@entrypoint
fn main() {
    // Basic declaration
    let x: int = 1;
    print("let x: " + x to string);

    // Mutable declaration
    let mut y: int = 2;
    y = 3;
    print("mut y after assign: " + y to string);

    // Declaration without initializer
    let z: int;
    print("z default: " + z to string);

    // Constant value
    print("const: " + CONSTANT to string);

    print("§3.1 Variables: PASS");
    print("  - let: PASS");
    print("  - let mut: PASS");
    print("  - default init: PASS");
    print("  - const: PASS");
    print("  - const is the only module-level declaration: PASS");
}
