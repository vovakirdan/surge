// EXPECT-DIAG: SEM3165
// Epic 11 Block 3 negative: mutable borrow capture (C04)
type Job = {
    id: int,
};

fn bump(r: &mut Job) -> int {
    return r.id;
}

fn start(mut job: Job) crosses -> far Task<int> {
    let r: &mut Job = &mut job;
    return spawn on pool {
        ret bump(r);
    };
}
