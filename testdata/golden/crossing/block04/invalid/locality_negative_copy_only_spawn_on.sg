// EXPECT-DIAG: SEM3170
// Epic 11 Block 4 negative: @copy-only crosses via spawn on (LOCALITY-008)
@copy
type Point = {
    x: int,
    y: int,
};

fn sum(p: own Point) -> int {
    return p.x + p.y;
}

fn run(p: own Point) -> far Task<int> {
    return spawn on distributed {
        ret sum(own p);
    };
}
