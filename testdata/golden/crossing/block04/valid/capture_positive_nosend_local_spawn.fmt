// positive: @nosend captured by @local spawn
@nosend
type LocalOnly = {
    id: int,
};

@entrypoint fn main() {
    let v: LocalOnly = { id: 1 };
    let t = @local spawn async {
        ret v.id;
    };
    compare t.await() {
        Success(_) => nothing;
        Cancelled() => nothing;
    };
}
