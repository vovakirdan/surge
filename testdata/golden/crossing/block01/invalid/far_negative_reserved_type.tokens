  1: KwType          "type" at 3:1-3:5 (leading: LineComment, Newline, LineComment, Newline)
  2: KwFar           "far" at 3:6-3:9 (leading: Space)
  3: Assign          "=" at 3:10-3:11 (leading: Space)
  4: Ident           "int" at 3:12-3:15 (leading: Space)
  5: Semicolon       ";" at 3:15-3:16
  6: EOF             at 4:1-4:1
