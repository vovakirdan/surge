// integration: far-task await/cancel plus direct-call crossing-effect inference.
fn wait_remote(t: far Task<int>) -> TaskResult<int> {
    return t.await();
}

fn cancel_remote(t: far Task<int>) -> TaskResult<nothing> {
    return t.cancel();
}

fn direct_on(dst: Placement) -> TaskResult<int> {
    return on dst {
        ret 5;
    };
}

fn wrap_on(dst: Placement) -> TaskResult<int> {
    return direct_on(dst);
}
