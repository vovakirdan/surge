// EXPECT-DIAG: SEM3167
// stdlib-facing probe: an owned TcpListener capture is rejected as shard-pinned.
fn consume(listener: own TcpListener) -> nothing {
    return nothing;
}

fn run(listener: own TcpListener) -> TaskResult<nothing> {
    return on pool {
        consume(own listener);
        ret nothing;
    };
}
