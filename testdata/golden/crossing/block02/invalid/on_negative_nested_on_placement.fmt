// Epic 11 Block 2 negative: nested on placement (ON-NEST-N001)
fn double(x: int) -> int {
    return x * 2;
}

fn run(n: int) crosses -> TaskResult<int> {
    return on pool {
        let inner: TaskResult<int> = on distributed {
            ret double(n);
        };
        ret double(n);
    };
}
