// EXPECT-DIAG: FUT7019
// EXPECT-STAGE: backend
// negative: on far handle crossing in a synchronous context
@shard_movable
type Message = {
    id: int,
};

fn send_job(ch: far Channel<Message>, msg: own Message) -> TaskResult<nothing> {
    return on ch {
        ch.send(own msg);
        ret nothing;
    };
}
