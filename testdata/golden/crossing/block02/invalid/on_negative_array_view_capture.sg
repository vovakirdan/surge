// EXPECT-DIAG: SEM3168
// negative: a view of another array, whose buffer the origin shard keeps
fn total(xs: own int[]) -> int {
    return xs[0];
}

async fn run() -> int {
    let base: int[] = [1, 2, 3, 4];
    let v: int[] = base[[1..3]];
    let r: TaskResult<int> = on pool {
        ret total(own v);
    };
    return compare r {
        Success(x) => x;
        Cancelled() => 0;
    };
}
