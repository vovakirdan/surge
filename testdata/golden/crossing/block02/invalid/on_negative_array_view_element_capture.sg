// EXPECT-DIAG: SEM3168
// negative: the capture owns its own buffer, but an element of it is a view
fn total(xss: own int[][]) -> int {
    return xss[0][0];
}

async fn run() -> int {
    let base: int[] = [1, 2, 3, 4];
    let v: int[] = base[[1..3]];
    let xs: int[][] = [v];
    let r: TaskResult<int> = on pool {
        ret total(own xs);
    };
    return compare r {
        Success(x) => x;
        Cancelled() => 0;
    };
}
