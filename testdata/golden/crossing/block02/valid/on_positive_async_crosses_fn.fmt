// Epic 11 Block 2 positive: async and crosses combined (ON-CROSS-V002)
fn double(x: int) -> int {
    return x * 2;
}

async fn run(n: int) crosses -> int {
    let r: TaskResult<int> = on pool {
        ret double(n);
    };
    return compare r {
        Success(v) => v;
        Cancelled() => 0;
    };
}
