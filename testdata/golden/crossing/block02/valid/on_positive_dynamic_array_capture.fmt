// positive: own dynamic array capture, accepted for the elements it holds
fn total(xs: own int[]) -> int {
    return xs[0] + xs[1];
}

async fn run() -> int {
    let xs: int[] = [1, 2];
    let r: TaskResult<int> = on pool {
        ret total(own xs);
    };
    return compare r {
        Success(v) => v;
        Cancelled() => 0;
    };
}
