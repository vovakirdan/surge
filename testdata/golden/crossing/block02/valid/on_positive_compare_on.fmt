// positive: compare on placement
@shard_movable
type Request = {
    id: int,
};

type Response = {
    code: int,
};

fn compute(req: own Request) -> Response {
    return Response { code: req.id };
}

fn default_response() -> Response {
    return Response { code: 0 };
}

async fn route(req: own Request) -> Response {
    compare on pool {
        ret compute(own req);
    } {
        Success(v) => return v;
        Cancelled() => return default_response();
    };
}
