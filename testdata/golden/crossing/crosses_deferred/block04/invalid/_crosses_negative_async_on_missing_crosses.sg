// EXPECT-DIAG: SEM3162
// Epic 11 Block 4 negative: async fn with on but no crosses (CROSSES-EFFECT-010)
fn double(x: int) -> int {
    return x * 2;
}

async fn route(n: int) -> int {
    let r: TaskResult<int> = on pool {
        ret double(n);
    };
    return compare r {
        Success(v) => v;
        Cancelled() => 0;
    };
}
