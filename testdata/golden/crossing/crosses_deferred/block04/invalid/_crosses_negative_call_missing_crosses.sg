// Epic 11 Block 4 negative: non-crosses caller of crosses fn (CROSSES-EFFECT-009)
fn double(x: int) -> int {
    return x * 2;
}

fn inner(n: int) crosses -> TaskResult<int> {
    return on pool {
        ret double(n);
    };
}

fn caller(n: int) -> TaskResult<int> {
    return inner(n);
}
