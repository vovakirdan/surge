@entrypoint
fn main() -> int {
    let r = (async {
        let ch = Channel::<int>::new(0:uint);
        let v = select {
            ch.recv() => 1;
            default => 2;
        };
        ret v;
    }).await();

    compare r {
        Success(v) => print("v=" + (v to string));
        Cancelled() => print("cancelled");
    };
    return 0;
}
