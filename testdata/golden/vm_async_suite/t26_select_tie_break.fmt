async fn ready(n: int) -> int {
    return n;
}

@entrypoint
fn main() -> int {
    let r = (async {
        let first = ready(1);
        let second = ready(2);
        let first_done = first.clone();
        let second_done = second.clone();
        let _ = first_done.await();
        let _ = second_done.await();
        let v = select {
            first.await() => 1;
            second.await() => 2;
        };
        ret v;
    }).await();

    compare r {
        Success(v) => print("v=" + (v to string));
        Cancelled() => print("cancelled");
    };
    return 0;
}
