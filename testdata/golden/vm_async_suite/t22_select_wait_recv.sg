@entrypoint
fn main() -> int {
    let r = (async {
        let ch = Channel::<int>::new(0:uint);
        let prod = spawn async {
            sleep(5).await();
            ch.send(7);
            ret 0;
        };

        let v = select {
            ch.recv() => 7;
            sleep(100).await() => 0;
        };

        let _ = prod.await();
        ret v;
    }).await();

    compare r {
        Success(v) => print("v=" + (v to string));
        Cancelled() => print("cancelled");
    };
    return 0;
}
