pragma module, no_std;

// Contracts for entrypoint parameter parsing and exit code conversion.

// Contract for types that can be parsed from a command-line argument string.
// Types implementing this contract can be used as parameters in @entrypoint("argv") functions.
pub contract FromArgv<T> {
    pub fn from_str(s: &string) -> Erring<T, Error>;
}

// Contract for types that can be parsed from stdin text.
// Types implementing this contract can be used as parameters in @entrypoint("stdin") functions.
pub contract FromStdin<T> {
    pub fn from_stdin(text: string) -> Erring<T, Error>;
}

// Contract for types that report a process exit code.
// An @entrypoint may return `nothing` (exit code 0), `int` (the code itself),
// or any type implementing this contract: the generated entry calls
// `__exit_code()` on the returned value and exits with its result.
// Exit codes are deliberately not a conversion: `__to(self, int)` would also
// let such a value silently become an `int` in a binding or a return.
pub contract ExitCode<T> {
    pub fn __exit_code(self: &T) -> int;
}

extern<int> {
    pub fn from_stdin(text: string) -> Erring<int, Error> { return int.from_str(&text); }
}

extern<uint> {
    pub fn from_stdin(text: string) -> Erring<uint, Error> { return uint.from_str(&text); }

    pub fn __exit_code(self: &uint) -> int { return (*self) to int; }
}

extern<int8> {
    pub fn from_stdin(text: string) -> Erring<int8, Error> { return int8.from_str(&text); }

    pub fn __exit_code(self: &int8) -> int { return (*self) to int; }
}

extern<int16> {
    pub fn from_stdin(text: string) -> Erring<int16, Error> { return int16.from_str(&text); }

    pub fn __exit_code(self: &int16) -> int { return (*self) to int; }
}

extern<int32> {
    pub fn from_stdin(text: string) -> Erring<int32, Error> { return int32.from_str(&text); }

    pub fn __exit_code(self: &int32) -> int { return (*self) to int; }
}

extern<int64> {
    pub fn from_stdin(text: string) -> Erring<int64, Error> { return int64.from_str(&text); }

    pub fn __exit_code(self: &int64) -> int { return (*self) to int; }
}

extern<uint8> {
    pub fn from_stdin(text: string) -> Erring<uint8, Error> { return uint8.from_str(&text); }
}

extern<uint16> {
    pub fn from_stdin(text: string) -> Erring<uint16, Error> { return uint16.from_str(&text); }
}

extern<uint32> {
    pub fn from_stdin(text: string) -> Erring<uint32, Error> { return uint32.from_str(&text); }
}

extern<uint64> {
    pub fn from_stdin(text: string) -> Erring<uint64, Error> { return uint64.from_str(&text); }
}

extern<float16> {
    pub fn from_stdin(text: string) -> Erring<float16, Error> { return float16.from_str(&text); }
}

extern<float32> {
    pub fn from_stdin(text: string) -> Erring<float32, Error> { return float32.from_str(&text); }
}

extern<float64> {
    pub fn from_stdin(text: string) -> Erring<float64, Error> { return float64.from_str(&text); }
}

extern<float> {
    pub fn from_stdin(text: string) -> Erring<float, Error> { return float.from_str(&text); }
}

extern<bool> {
    pub fn from_stdin(text: string) -> Erring<bool, Error> { return bool.from_str(&text); }
}

extern<string> {
    pub fn from_stdin(text: string) -> Erring<string, Error> { return Success(text); }
}
