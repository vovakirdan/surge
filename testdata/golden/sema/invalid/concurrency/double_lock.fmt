// Invalid: double lock acquisition

pub async fn test_double_lock() -> nothing {
    let mut mtx: Mutex = Mutex.new();
    mtx.lock().await();
    mtx.lock().await();  // Error: already locked
    mtx.unlock();
    mtx.unlock();
}

type Data = {
    lock: Mutex,
}

extern<Data> {
    pub async fn bad_double_lock(self: &mut Data) -> nothing {
        self.lock.lock().await();
        self.lock.lock().await();  // Error: already locked
        self.lock.unlock();
        self.lock.unlock();
    }
}
