// Invalid: calling @acquires_lock when already held
type Resource = { lock: Mutex }

extern<Resource> {
    @acquires_lock("lock")
    async fn acquire(self: &mut Resource) -> nothing {
        self.lock.lock().await();
    }

    pub async fn double_acquire(self: &mut Resource) -> nothing {
        self.lock.lock().await();
        self.acquire().await();  // ERROR: lock already held
        self.lock.unlock();
    }
}
