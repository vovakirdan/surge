// Unbalanced lock state across branches

pub async fn test_lock_only_in_then(cond: bool) -> nothing {
    let mut mtx: Mutex = Mutex.new();
    if cond {
        mtx.lock().await();
    }
    // Error: lock may be held in one branch but not another
}

pub async fn test_unlock_only_in_else(cond: bool) -> nothing {
    let mut mtx: Mutex = Mutex.new();
    mtx.lock().await();
    if cond {
        // nothing
    } else {
        mtx.unlock();
    }
    // Error: lock may be held in one branch but not another
}
