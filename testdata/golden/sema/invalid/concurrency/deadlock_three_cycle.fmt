// Test: Deadlock detection - three-lock cycle A->B->C->A
// Three functions create a circular dependency

type ThreeLocks = {
    lock_a: Mutex,
    lock_b: Mutex,
    lock_c: Mutex,
    data: int
}

extern<ThreeLocks> {
    // A -> B
    async fn func_ab(self: &mut ThreeLocks) {
        self.lock_a.lock().await();
        self.lock_b.lock().await();
        self.data = 1;
        self.lock_b.unlock();
        self.lock_a.unlock();
    }

    // B -> C
    async fn func_bc(self: &mut ThreeLocks) {
        self.lock_b.lock().await();
        self.lock_c.lock().await();
        self.data = 2;
        self.lock_c.unlock();
        self.lock_b.unlock();
    }

    // C -> A - completes the cycle!
    async fn func_ca(self: &mut ThreeLocks) {
        self.lock_c.lock().await();
        self.lock_a.lock().await();  // DEADLOCK: C -> A closes A->B->C->A cycle
        self.data = 3;
        self.lock_a.unlock();
        self.lock_c.unlock();
    }
}
