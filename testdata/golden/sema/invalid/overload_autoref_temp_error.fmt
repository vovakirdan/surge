// scenario: the only `__add` borrows `self`, and a temporary operand cannot be borrowed (autoref of a temporary)
type Point = {
    x: int,
    y: int,
};

extern<Point> {
    fn __add(self: &Point, other: &Point) -> Point {
        return { x: self.x + other.x, y: self.y + other.y };
    }
}

fn main() {
    let p2: Point = { x: 3, y: 4 };
    let _ = Point { x: 1, y: 2 } + p2;
}
