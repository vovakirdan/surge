// Test: stdin requires exact from_stdin(string), never a from_str fallback
// Expected: SEM3125

type Data = {
    value: int,
};

extern<Data> {
    pub fn from_str(_text: &string) -> Erring<Data, Error> {
        return Success(Data { value = 1 });
    }
}

@entrypoint("stdin")
fn main(d: Data) -> int {
    return d.value;
}
