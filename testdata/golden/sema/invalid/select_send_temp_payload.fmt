fn build() -> string {
    let mut s = "seed-";
    s = s + "x";
    return s;
}

async fn pump() -> nothing {
    let ch = Channel::<string>::new(1:uint);
    let rx = Channel::<int>::new(1:uint);
    let v = select {
        ch.send(own build()) => 1;
        rx.recv() => 2;
    };
    print("done\n");
}
