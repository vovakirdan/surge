// A magic operator whose body returns a slice of what its REFERENCE parameter
// points at gives its caller a window into the caller's own frame. Nothing in
// the caller spells the borrow: the operand is borrowed implicitly, and the
// result is typed `uint64[]` like any owned array.
//
// Five spellings, each reaching the rule by a different route: a binary
// operator through a binding, a binary operator returned directly, a unary
// operator, a user `__index` whose window is its own range, and a call one
// level deeper, whose callee returns the window through a reference parameter
// of its own - the transitive arm.
type Arr = { items: uint64[4] };

extern<Arr> {
    fn __add(self: &Arr, other: &Arr) -> uint64[] {
        return self.items[[0..2]];
    }
    fn __neg(self: &Arr) -> uint64[] {
        return self.items[[1..3]];
    }
    fn __index(self: &Arr, window: Range<int>) -> uint64[] {
        return self.items[window];
    }
}

fn bound() -> uint64[] {
    let a: Arr = Arr { items = [11:uint64, 22:uint64, 33:uint64, 44:uint64] };
    let b: Arr = Arr { items = [55:uint64, 66:uint64, 77:uint64, 88:uint64] };
    let v = a + b;
    return v;
}

fn direct() -> uint64[] {
    let a: Arr = Arr { items = [11:uint64, 22:uint64, 33:uint64, 44:uint64] };
    let b: Arr = Arr { items = [55:uint64, 66:uint64, 77:uint64, 88:uint64] };
    return a + b;
}

fn negated() -> uint64[] {
    let a: Arr = Arr { items = [11:uint64, 22:uint64, 33:uint64, 44:uint64] };
    return -a;
}

fn windowed() -> uint64[] {
    let a: Arr = Arr { items = [11:uint64, 22:uint64, 33:uint64, 44:uint64] };
    return a[[0..2]];
}

fn mid(x: &Arr) -> uint64[] {
    return x + x;
}

fn leak_mid() -> uint64[] {
    let a: Arr = Arr { items = [11:uint64, 22:uint64, 33:uint64, 44:uint64] };
    return mid(&a);
}

@entrypoint
fn main() -> int {
    let p = bound();
    let q = direct();
    let r = negated();
    let s = windowed();
    let t = leak_mid();
    return (p[0] to int) + (q[0] to int) + (r[0] to int) + (s[0] to int) + (t[0] to int);
}
