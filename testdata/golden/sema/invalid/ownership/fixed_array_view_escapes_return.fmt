// A slice of a FIXED array points at the frame that declares it, so it cannot
// be returned. A dynamic array's slice can be: the runtime registers that view
// against its base header and defers the base's reclamation. A fixed array has
// no header to register against.
//
// Both spellings are here because they reach the rule by different routes: the
// bare slice through the expression, the bound one through the binding that
// carries its provenance.
fn bare() -> uint64[] {
    let xs: uint64[4] = [11:uint64, 22:uint64, 33:uint64, 44:uint64];
    return xs[[1..3]];
}

fn bound() -> uint64[] {
    let ys: uint64[4] = [11:uint64, 22:uint64, 33:uint64, 44:uint64];
    let v = ys[[1..3]];
    return v;
}

@entrypoint
fn main() -> int {
    let a = bare();
    let b = bound();
    return (a[0] to int) + (b[0] to int);
}
