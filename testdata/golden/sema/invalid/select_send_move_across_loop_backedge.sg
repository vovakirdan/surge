async fn pump() -> nothing {
    let ch = Channel::<string>::new(1:uint);
    let stop = Channel::<int>::new(1:uint);
    let mut job = "job-";
    job = job + "payload";
    while true {
        select {
            ch.send(own job) => { break; };
            stop.recv() => { continue; };
        };
    }
    print("sent\n");
}
