// The shapes the escape rule must NOT touch.
//
// A view over a REFERENCE parameter is fine: the referent is the caller's, so
// it outlives this frame. A dynamic array's view is fine for the registry
// reason. And a fixed view used and dropped inside one frame was never in
// question - refusing it would remove far more than the escape rule intends.
fn through_ref(xs: &uint64[4]) -> uint64[] {
    return xs[[1..3]];
}

fn dynamic() -> uint64[] {
    let mut xs: uint64[] = [11:uint64, 22:uint64, 33:uint64, 44:uint64];
    return xs[[1..3]];
}

@entrypoint
fn main() -> int {
    let xs: uint64[4] = [11:uint64, 22:uint64, 33:uint64, 44:uint64];
    let local = xs[[1..3]];
    let borrowed = through_ref(&xs);
    let heap = dynamic();
    return (local[0] to int) + (borrowed[0] to int) + (heap[0] to int);
}
