// Valid: a clone may leave the frame once the task it names has been joined on
// every path to that exit, because the borrow of `l` ended with the child; and a
// clone of a task that borrows nothing carries nothing out.
//
// The clone leaves by being handed to a callee. It used to leave by `return`
// from the `async fn` that joined it, but a task whose result is a task is a
// compile error (SEM3223, owner ruling 2026-09-26), so a frame that can join
// can no longer return a handle. The same clones handed on without the join on
// every path are refused (SEM3021) at the borrow the spawn took.

async fn worker(x: &int64) -> int64 {
    return *x;
}

async fn plain(x: int64) -> int64 {
    return x;
}

fn hand_off(t: Task<int64>) -> nothing {
    return nothing;
}

async fn joined_then_clone_handed_on() -> int64 {
    let l: int64 = 5;
    let t = spawn worker(&l);
    let c = t.clone();
    let _ = t.await();
    hand_off(c);
    return 0;
}

fn borrow_free_clone_returned() -> Task<int64> {
    let v: int64 = 5;
    let t = spawn plain(v);
    let c = t.clone();
    hand_off(t);
    return c;
}

async fn joined_before_ret() -> int64 {
    let l: int64 = 5;
    let t = spawn worker(&l);
    let c = t.clone();
    return {
        let _ = t.await();
        hand_off(c);
        ret 0:int64;
    };
}

async fn drained_then_clone_handed_on() -> int64 {
    let l: int64 = 5;
    let t = spawn worker(&l);
    let c = t.clone();
    let mut tasks: Task<int64>[] = [];
    tasks.push(t);
    while tasks.__len() > 0:uint {
        let x = tasks.pop().safe();
        let _ = x.await();
    }
    hand_off(c);
    return 0;
}

async fn middle_clone_joined() -> int64 {
    let l: int64 = 5;
    let t = spawn worker(&l);
    let c1 = t.clone();
    let c2 = c1.clone();
    hand_off(t);
    let _ = c1.await();
    hand_off(c2);
    return 0;
}
