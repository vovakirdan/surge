// The two view facts the resize rule must WITHDRAW, both measured running and
// correct on the tree before the `on` capture gate learned to ask about views.
//
// `v` is bound to a window and then UNCONDITIONALLY rebound to an array of its
// own: from the assignment on it owns its buffer, so growing it cannot reach
// `base`. `xs` HOLDS a window at position 0 and an array of its own at position
// 1: growing element 1 cannot reach `base` either, and which slot a subscript
// names is not a question this checker answers, so it must not guess here.
//
// Both were refused with SEM3015 ("array view is not resizable") for one commit,
// while the crossing gate's never-withdrawn view fact was shared with this rule.
// A crossing has a runtime registry behind it and can afford that guess; this
// rule has nothing behind it, and its refusal is final.
@entrypoint
fn main() -> int {
    let base: int[] = [1, 2, 3, 4];

    let mut v: int[] = base[[1..3]];
    v = [9, 9];
    v.push(5);
    let _ = v.pop();
    v.reserve(8:uint);

    let win: int[] = base[[1..3]];
    let own1: int[] = [7, 8];
    let mut xs: int[][] = [win, own1];
    xs[1].push(9);

    return v[0] + base[1] + (len(xs[1]) to int);
}
