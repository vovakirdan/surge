// A borrowed arm may directly hand out a heap-free Copy payload. Fixed-width
// integer fields have no counted owners to duplicate. The invalid twins keep
// the direct hand-out and give the payload counted int or string fields.
@copy type Pair = { a: int64, b: int64 };

tag Hold(Pair);
tag Nothing_();
type Held = Hold(Pair) | Nothing_;

fn payload_of(h: &Held) -> Pair {
    return compare *h {
        Hold(p) => p;
        _ => Pair { a = (0:int64), b = (0:int64) };
    };
}

@entrypoint
fn main() -> int {
    let h: Held = Hold(Pair { a = (1:int64), b = (2:int64) });
    let got = payload_of(&h);
    return ((got.a + got.b) - (3:int64)) to int;
}
