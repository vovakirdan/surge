// A panic several calls deep, so the backtrace has to name frames the
// innermost one cannot supply. The fixtures that came before this one all
// panicked directly in `main`, which a two-frame implementation would satisfy
// without ever walking a stack.
fn level3(a: int[]) -> int {
    return a[9];
}

fn level2(a: int[]) -> int {
    return level3(a);
}

fn level1(a: int[]) -> int {
    return level2(a);
}

@entrypoint
fn main() -> int {
    let xs: int[] = [1, 2, 3];
    return level1(xs);
}
