@entrypoint
fn main() -> int {
    let r = (async {
        let a = spawn async {
            checkpoint().await();
            checkpoint().await();
            checkpoint().await();
            ret 1;
        };
        let b = spawn async { ret 2; };

        ret 0;
    }).await();

    compare r {
        Success(v) => print("parent=" + (v to string));
        Cancelled() => print("parent=cancelled");
    };
    return 0;
}
