@entrypoint
fn main() -> int {
    let gate = Channel::<int>::new(0:uint);
    let started = Channel::<int>::new(1:uint);
    let parent = spawn async {
        let child = spawn async {
            let _ = gate.recv();
            ret 123;
        };

        started.send(1);
        let _ = child.await();
        ret 0;
    };

    let _ = started.recv();
    parent.cancel();

    let pr = parent.await();
    compare pr {
        Success(_) => print("parent=success");
        Cancelled() => print("parent=cancelled");
    };
    return 0;
}
