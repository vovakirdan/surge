// Test: __surge_start for entrypoint returning a custom type implementing ExitCode (__exit_code)
type MyExitCode = {
    code: int,
}

extern<MyExitCode> {
    fn __exit_code(self: &MyExitCode) -> int {
        return self.code;
    }
}

@entrypoint
fn main() -> MyExitCode {
    return MyExitCode { code = 42 };
}
