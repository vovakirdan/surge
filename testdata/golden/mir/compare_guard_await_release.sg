async fn inc(x: int) -> int {
    return x + 1;
}

async fn slow(n: int) -> bool {
    return n > 0;
}

async fn test() -> int {
    let a = spawn inc(5);
    let b = spawn slow(1);
    return compare a.await() {
        Success(x) if compare b.await() { Success(v) => v; Cancelled() => false; } => x;
        Cancelled() => 0;
    };
}
