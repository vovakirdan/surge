// A NEGATIVE shift count. The guard the other shift fixtures reach is an
// upper bound; this one is the lower bound, and it is a separate comparison.
// A guard written as an unsigned "count >= width" passes a negative count
// through, and what reaches the host is a shift by a huge unsigned number.
@entrypoint
fn main() -> int {
    let a: int8 = 1;
    let b: int8 = -1;
    let _ = a << b;
    return 0;
}
