async fn work() -> int {
    return 5;
}
async fn child() -> int {
    let n = spawn work();
    checkpoint().await();
    print("after-checkpoint");
    let r = timeout(n, 1000:uint);
    print("after-timeout");
    return compare r { Success(v) => v; Cancelled() => 1; };
}

async fn run() -> int {
    let t = spawn child();
    checkpoint().await();
    t.cancel();
    return compare t.await() { Success(v) => v; Cancelled() => 90; };
}

@entrypoint
fn main() -> int {
    let t = spawn run();
    return compare t.await() { Success(v) => v; Cancelled() => 91; };
}
