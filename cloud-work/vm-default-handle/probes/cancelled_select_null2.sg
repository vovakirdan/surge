async fn child() -> int {
    let c = default::<Channel<int>>();
    print("child-start");
    let w: int = select { c.recv() => 20; };
    print("after-select " + (w to string));
    return w;
}

async fn run() -> int {
    let t = spawn child();
    checkpoint().await();
    t.cancel();
    return compare t.await() { Success(v) => v; Cancelled() => 90; };
}

@entrypoint
fn main() -> int {
    let t = spawn run();
    return compare t.await() { Success(v) => v; Cancelled() => 91; };
}
