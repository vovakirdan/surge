// stdlib/term/term.sg
// Terminal events and convenience wrappers.
pragma module;

pub type TermMods = uint8;
pub enum TermMod: TermMods = { SHIFT = 1, ALT = 2, CTRL = 4, META = 8 };

@copy
pub type KeyEvent = {
    key: TermKey,
    mods: TermMods
};

pub tag Char(uint32);
pub tag Enter();
pub tag Esc();
pub tag Backspace();
pub tag Tab();
pub tag Up();
pub tag Down();
pub tag Left();
pub tag Right();
pub tag Home();
pub tag End();
pub tag PageUp();
pub tag PageDown();
pub tag Delete();
pub tag F(uint8);
@copy
pub type TermKey =
    Char(uint32) | Enter() | Esc() | Backspace() | Tab() |
    Up() | Down() | Left() | Right() | Home() | End() |
    PageUp() | PageDown() | Delete() | F(uint8);

pub tag Key(KeyEvent);
pub tag Resize(int64, int64);
pub tag Eof();
@copy
pub type TermEvent = Key(KeyEvent) | Resize(int64, int64) | Eof();

pub fn enter() -> nothing {
    term_enter_alt_screen();
    term_hide_cursor();
    term_set_raw_mode(true);
    return nothing;
}

pub fn leave() -> nothing {
    term_set_raw_mode(false);
    term_show_cursor();
    term_exit_alt_screen();
    return nothing;
}

pub fn write_str(s: &string) -> nothing {
    term_write((*s) to byte[]);
    return nothing;
}

// Spawn this cold task when the caller consumes the event channel concurrently.
pub async fn read_event_async(ch: Channel<TermEvent>) -> nothing {
    while true {
        let read = blocking { ret term_read_event(); };
        let ev = compare read.await() {
            Success(event) => event;
            Cancelled() => { return nothing; }
        };
        let done = compare ev {
            Eof() => true;
            _ => false;
        };
        ch.send(ev);
        if done {
            return nothing;
        }
    }
    return nothing;
}
