pragma module;

// stdlib/http/interim_copy.sg
//
// INTERIM, and this whole file is meant to be DELETED.
//
// Taking a field out of a value that dies immediately after — building a
// `Request` from a head that is about to drop, handing a `Response` out of a
// `Context` that is about to drop — is a PARTIAL MOVE. Sema tracks moves per
// binding rather than per place, so it cannot invalidate just the field that
// left, and the read produces a second NAME for the field instead of taking it.
// The container's drop then frees what the escaping value holds: measured as a
// use-after-free plus a double free, on both the by-value-receiver shape and
// the struct-literal shape, while the program still printed the right answer.
//
// `clone()` closes that for a `string`, but there is no `__clone` for a
// composite, an array, or a union, so the shapes below need spelling out.
//
// Epic 24 step 8 makes `own head.method` a real partial move. At that point
// every caller of these helpers goes back to reading the field directly and
// this file goes away. Do not build on it.
//
// Every helper takes a BORROW: reading a field through a reference is not a
// move and needs none of this.

fn copy_bytes(src: &byte[]) -> byte[] {
    let mut out: byte[] = [];
    let length: uint = src.__len();
    if length != 0:uint {
        out.reserve(length);
        append_bytes(&mut out, src);
    }
    return out;
}

fn copy_headers(headers: &Headers) -> Headers {
    let mut out: Headers = [];
    let count: int = headers.__len() to int;
    if count > 0 {
        out.reserve(headers.__len());
    }
    let mut i: int = 0;
    while i < count {
        out.push(Header { key = clone(headers[i].key), value = clone(headers[i].value) });
        i = i + 1;
    }
    return out;
}

fn copy_byte_stream(stream: &ByteStream) -> ByteStream {
    let mut chunks: byte[][] = [];
    let count: int = stream.chunks.__len() to int;
    if count > 0 {
        chunks.reserve(stream.chunks.__len());
    }
    let mut i: int = 0;
    while i < count {
        chunks.push(copy_bytes(stream.chunks[i]));
        i = i + 1;
    }
    return ByteStream { chunks = chunks, index = stream.index };
}

fn copy_body_reader(reader: &BodyReader) -> BodyReader {
    return BodyReader {
        mode = reader.mode,
        raw = copy_bytes(reader.raw),
        cursor = reader.cursor,
        remaining = reader.remaining,
        done = reader.done,
        limit_remaining = reader.limit_remaining
    };
}

fn copy_response_body(body: &ResponseBody) -> ResponseBody {
    return compare body {
        Empty() => Empty();
        Bytes(b) => Bytes(copy_bytes(b));
        Stream(s) => Stream(copy_byte_stream(s));
    };
}

fn copy_request(req: &Request) -> Request {
    return Request {
        method = clone(req.method),
        target = clone(req.target),
        path = clone(req.path),
        query = clone(req.query),
        version = req.version,
        headers = copy_headers(req.headers),
        body = copy_body_reader(req.body)
    };
}

fn copy_response(resp: &Response) -> Response {
    return Response {
        status = resp.status,
        headers = copy_headers(resp.headers),
        body = copy_response_body(resp.body)
    };
}
